local config = _G.CollapseConfig or {
    message1 = "t1",
    message2 = "t2",
    message3 = "t3",
    TimePerPlayer = 15,
    TeleportOffset = 10,
    ServerHop = { hours = 0, minutes = 1 },
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local TextChatService = game:GetService("TextChatService")
local isLegacyChat = TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService
local localPlayer = Players.LocalPlayer

math.randomseed(tick() * 1000)
math.random(); math.random(); math.random()

local function getAllPlayerNamesLower()
    local out = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name then out[string.lower(p.Name)] = true end
    end
    return out
end

local function makeRandomToken()
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local len = math.random(1, 7)
    local t = {}
    for i = 1, len do
        local idx = math.random(1, #chars)
        t[i] = chars:sub(idx, idx)
    end
    return table.concat(t)
end

local function randomSuffixAvoidTagging()
    local playersLower = getAllPlayerNamesLower()
    local tries = 0
    while tries < 40 do
        local token = makeRandomToken()
        if not playersLower[string.lower(token)] then
            return token
        end
        tries = tries + 1
    end
    local fallback = makeRandomToken()
    if #fallback < 7 then
        fallback = fallback .. tostring(math.random(0,9))
    else
        fallback = fallback:sub(1,6) .. tostring(math.random(0,9))
    end
    return fallback
end

local function sendViaTextChatService(msg)
    if not TextChatService then return false end
    local ok, err = pcall(function()
        local channels = TextChatService.TextChannels
        if channels and channels.RBXGeneral and channels.RBXGeneral.SendAsync then
            channels.RBXGeneral:SendAsync(msg)
        else
            error("RBXGeneral channel / SendAsync not available")
        end
    end)
    return ok
end

local function sendViaLegacyEvent(msg)
    local ok = pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if ev and ev:FindFirstChild("SayMessageRequest") then
            ev.SayMessageRequest:FireServer(msg, "All")
        else
            error("SayMessageRequest not found")
        end
    end)
    return ok
end

local function sendChatMessageWithSuffix(base)
    if not base or tostring(base) == "" then return end
    local suffix = randomSuffixAvoidTagging()
    local msg = tostring(base) .. " " .. suffix
    if sendViaTextChatService(msg) then
        return true
    end
    if sendViaLegacyEvent(msg) then
        return true
    end
    warn("Failed to send chat message via both TextChatService and legacy event. Msg:", msg)
    return false
end

local function getMessages()
    local msgs = {}
    if config.message1 and tostring(config.message1) ~= "" then table.insert(msgs, tostring(config.message1)) end
    if config.message2 and tostring(config.message2) ~= "" then table.insert(msgs, tostring(config.message2)) end
    if config.message3 and tostring(config.message3) ~= "" then table.insert(msgs, tostring(config.message3)) end
    if #msgs == 0 then
        local fallback = tostring(config.message or "test")
        for i = 1, 3 do table.insert(msgs, fallback) end
    end
    return msgs
end

local function getValidTargets()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, plr)
        end
    end
    return list
end

local currentLock = {}
local function clearLock()
    if currentLock.heartbeatConn then currentLock.heartbeatConn:Disconnect() currentLock.heartbeatConn = nil end
    if currentLock.alignPos and currentLock.alignPos.Parent then currentLock.alignPos:Destroy() end
    if currentLock.alignOri and currentLock.alignOri.Parent then currentLock.alignOri:Destroy() end
    if currentLock.attachMy and currentLock.attachMy.Parent then currentLock.attachMy:Destroy() end
    if currentLock.attachTarget and currentLock.attachTarget.Parent then currentLock.attachTarget:Destroy() end
    currentLock = {}
end

local function createLock(target)
    clearLock()
    if not target or not target.Character then return end
    local myChar = localPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp or not targetHrp then return end
    myHrp.CanCollide = false
    local attachMy = Instance.new("Attachment", myHrp)
    local attachTarget = Instance.new("Attachment", targetHrp)
    attachTarget.Position = Vector3.new(0, config.TeleportOffset, 0)
    local alignPos = Instance.new("AlignPosition", myHrp)
    alignPos.Attachment0 = attachMy
    alignPos.Attachment1 = attachTarget
    alignPos.RigidityEnabled = true
    alignPos.MaxForce = 9e9
    alignPos.Responsiveness = 200
    alignPos.ReactionForceEnabled = true
    local alignOri = Instance.new("AlignOrientation", myHrp)
    alignOri.Attachment0 = attachMy
    alignOri.Attachment1 = attachTarget
    alignOri.RigidityEnabled = true
    alignOri.MaxTorque = 9e9
    alignOri.Responsiveness = 200
    currentLock = { attachMy = attachMy, attachTarget = attachTarget, alignPos = alignPos, alignOri = alignOri }
    currentLock.heartbeatConn = RunService.Heartbeat:Connect(function()
        if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then clearLock() return end
        local targetHrp2 = target.Character:FindFirstChild("HumanoidRootPart")
        local myHrp2 = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHrp2 and targetHrp2 then
            pcall(function() myHrp2.CFrame = targetHrp2.CFrame + Vector3.new(0, config.TeleportOffset, 0) end)
        end
    end)
end

local function teleportAbove(target)
    if not target or not target.Character then return false end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local myChar = localPlayer.Character
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    local success, err = pcall(function() myHrp.CFrame = hrp.CFrame + Vector3.new(0, config.TeleportOffset, 0) end)
    if not success then warn("Teleport failed: ", err) end
    createLock(target)
    return success
end

spawn(function()
    math.randomseed(tick())
    while true do
        if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            repeat task.wait() until localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        end
        local targets = getValidTargets()
        if #targets == 0 then task.wait(2) continue end
        local target = targets[math.random(1, #targets)]
        teleportAbove(target)
        local messages = getMessages()
        for i = 1, #messages do
            sendChatMessageWithSuffix(messages[i])
            task.wait(5)
            if not target.Parent or not target.Character or not localPlayer.Character then break end
        end
        local remainder = (config.TimePerPlayer or 15) - (#messages * 5)
        if remainder > 0 then
            local startTick = tick()
            while tick() - startTick < remainder do
                if not target.Parent or not target.Character then break end
                task.wait(0.5)
            end
        end
        clearLock()
        task.wait(0.2)
    end
end)

if config.ServerHop then
    local hours = tonumber(config.ServerHop.hours) or 0
    local minutes = tonumber(config.ServerHop.minutes) or 0
    local totalTime = (hours * 3600) + (minutes * 60)
    if totalTime > 0 then
        task.spawn(function()
            print(("Server hop scheduled in %d hours %d minutes (%d seconds total)"):format(hours, minutes, totalTime))
            local endTime = tick() + totalTime
            while tick() < endTime do
                local remaining = math.max(0, math.floor(endTime - tick()))
                if remaining <= 5 or remaining % 10 == 0 then
                    local h = math.floor(remaining / 3600)
                    local m = math.floor((remaining % 3600) / 60)
                    local s = remaining % 60
                    print(("Server-hop in %02dh:%02dm:%02ds"):format(h, m, s))
                end
                task.wait(1)
            end
            print("Server-hop timer reached — teleporting to new server...")
            pcall(clearLock)
            pcall(function() TeleportService:Teleport(game.PlaceId, localPlayer) end)
        end)
    end
end

spawn(function()
    while true do
        task.wait(0.3)
        if not localPlayer.Character then continue end
        local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid then continue end
        local maxH = humanoid.MaxHealth
        local curH = humanoid.Health
        if maxH > 0 and curH / maxH <= 0.2 then
            pcall(function() humanoid.Health = 0 end)
        end
    end
end)

return config