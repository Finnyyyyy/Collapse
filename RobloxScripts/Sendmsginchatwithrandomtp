local function rint(a,b) return math.random(a,b) end

local function randomSuffix()
    local len = rint(3,7)
    local pickWordChance = 0.45
    if math.random() < pickWordChance and #WORDS > 0 then
        local tries = 0
        while tries < 40 do
            local w = WORDS[math.random(1,#WORDS)]
            if #w >= 3 and #w <= 7 then
                if math.random() < 0.35 then w = w:sub(1,1):upper() .. w:sub(2) end
                if math.random() < 0.12 then w = w .. tostring(math.random(0,9)) end
                if math.random() < 0.08 then w = w .. "!"; end
                return w
            end
            tries = tries + 1
        end
    end
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+[]{};:,.?/"
    local out = {}
    for i = 1, len do
        out[#out + 1] = chars:sub(math.random(1, #chars), math.random(1, #chars))
    end
    return table.concat(out)
end

local function withRandomSuffix(msg)
    return tostring(msg) .. " " .. randomSuffix()
end

local function getMessages()
    local msgs = {}
    if config.message1 and tostring(config.message1) ~= "" then table.insert(msgs, tostring(config.message1)) end
    if config.message2 and tostring(config.message2) ~= "" then table.insert(msgs, tostring(config.message2)) end
    if config.message3 and tostring(config.message3) ~= "" then table.insert(msgs, tostring(config.message3)) end
    if #msgs == 0 then
        local fallback = tostring(config.message or "test")
        for i = 1, 3 do table.insert(msgs, fallback) end
    end
    return msgs
end

local function getValidTargets()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, plr)
        end
    end
    return list
end

local currentLock = {}
local function clearLock()
    if currentLock.heartbeatConn then currentLock.heartbeatConn:Disconnect() currentLock.heartbeatConn = nil end
    if currentLock.alignPos and currentLock.alignPos.Parent then currentLock.alignPos:Destroy() end
    if currentLock.alignOri and currentLock.alignOri.Parent then currentLock.alignOri:Destroy() end
    if currentLock.attachMy and currentLock.attachMy.Parent then currentLock.attachMy:Destroy() end
    if currentLock.attachTarget and currentLock.attachTarget.Parent then currentLock.attachTarget:Destroy() end
    currentLock = {}
end

local function createLock(target)
    clearLock()
    if not target or not target.Character then return end
    local myChar = localPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp or not targetHrp then return end
    myHrp.CanCollide = false
    local attachMy = Instance.new("Attachment")
    attachMy.Name = "__lock_attach_my"
    attachMy.Parent = myHrp
    attachMy.Position = Vector3.new(0, 0, 0)
    local attachTarget = Instance.new("Attachment")
    attachTarget.Name = "__lock_attach_target"
    attachTarget.Parent = targetHrp
    attachTarget.Position = Vector3.new(0, config.TeleportOffset, 0)
    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "__lock_align_pos"
    alignPos.Attachment0 = attachMy
    alignPos.Attachment1 = attachTarget
    alignPos.RigidityEnabled = true
    alignPos.MaxForce = 9e9
    alignPos.Responsiveness = 200
    alignPos.ReactionForceEnabled = true
    alignPos.Parent = myHrp
    local alignOri = Instance.new("AlignOrientation")
    alignOri.Name = "__lock_align_ori"
    alignOri.Attachment0 = attachMy
    alignOri.Attachment1 = attachTarget
    alignOri.RigidityEnabled = true
    alignOri.MaxTorque = 9e9
    alignOri.Responsiveness = 200
    alignOri.Parent = myHrp
    currentLock.attachMy = attachMy
    currentLock.attachTarget = attachTarget
    currentLock.alignPos = alignPos
    currentLock.alignOri = alignOri
    currentLock.heartbeatConn = RunService.Heartbeat:Connect(function()
        if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
            clearLock()
            return
        end
        local targetHrp2 = target.Character:FindFirstChild("HumanoidRootPart")
        local myHrp2 = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHrp2 and targetHrp2 then
            pcall(function() myHrp2.CFrame = targetHrp2.CFrame + Vector3.new(0, config.TeleportOffset, 0) end)
        end
    end)
end

local function teleportAbove(target)
    if not target or not target.Character then return false end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local myChar = localPlayer.Character
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    local success, err = pcall(function() myHrp.CFrame = hrp.CFrame + Vector3.new(0, config.TeleportOffset, 0) end)
    if not success then warn("Teleport failed: ", err) end
    createLock(target)
    return success
end

local function startServerHopIfConfigured()
    local sh = config.ServerHop
    if type(sh) ~= "table" then return end
    local hours = tonumber(sh.hours) or 0
    local minutes = tonumber(sh.minutes) or 0
    local delaySec = hours * 3600 + minutes * 60
    if delaySec <= 0 then return end
    spawn(function()
        while true do
            local start = tick()
            while tick() - start < delaySec do task.wait(1) end
            pcall(clearLock)
            pcall(function() TeleportService:Teleport(game.PlaceId, localPlayer) end)
        end
    end)
end

startServerHopIfConfigured()

spawn(function()
    math.randomseed(tick())
    while true do
        if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            repeat task.wait() until localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        end
        local targets = getValidTargets()
        if #targets == 0 then task.wait(2) continue end
        local target = targets[math.random(1, #targets)]
        teleportAbove(target)
        local messages = getMessages()
        for i = 1, #messages do
            local msgToSend = withRandomSuffix(messages[i])
            sendChatMessage(msgToSend)
            task.wait(3)
            if not target.Parent or not target.Character or not localPlayer.Character then break end
        end
        local remainder = (config.TimePerPlayer or 15) - (#messages * 3)
        if remainder > 0 then
            local startTick = tick()
            while tick() - startTick < remainder do
                if not target.Parent or not target.Character then break end
                task.wait(0.5)
            end
        end
        clearLock()
        task.wait(0.2)
    end
end)

return config
